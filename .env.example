# Optional: raises NCBI E-utilities rate limit from 3 req/sec to 10 req/sec.
# Not required at current ingestion volume. Get one at:
# https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=

# Required for embedding chunks with OpenAI's text-embedding-3-small.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Required: the vector index is hosted on Pinecone (the corpus with PMC full
# text is ~315MB, too large to keep in the repo). Create a free serverless
# project at https://app.pinecone.io and copy its API key here.
PINECONE_API_KEY=
